                                                      {
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	    "source": "~/.config/fastfetch/nixos.txt",
	  "padding": {
            "right": 0
	    }
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "------------------------------",
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "34",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            "format": "{} packages",
            "key": " ",
            "keyColor": "34",  
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "34", 
        },
        {
            "type": "media",
            "key": " ",
            "keyColor": "34", 
        },
    ]
}
